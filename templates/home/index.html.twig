{% extends 'base.html.twig' %}

{% block title %}🏰 Accueil - L'Aventure d'Hyrule{% endblock %}

{% block body %}
<div class="home-content">

    <!-- HERO SECTION -->
    <section class="home-hero">
        <h1>Bienvenue {% if username is defined %}{{ username }}{% else %}Héros{% endif %} !</h1>
        <p>Prépare-toi à explorer les terres d'Hyrule et à relever ses défis légendaires.</p>

        <div class="cta-buttons">
            {% if player is defined and player %}
                <a href="{{ path('app_gallery') }}" class="btn btn-secondary btn-lg">Ma galerie</a>
                <a href="{{ path('app_profile_index') }}" class="btn btn-outline btn-lg">Mon profil</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">Se connecter</a>
                <a href="{{ path('app_register') }}" class="btn btn-accent btn-lg">S'inscrire</a>
            {% endif %}
        </div>
    </section>

    <!-- ZONES -->
    {% if zones is defined and zones %}
    <section class="categories-grid">
        {% for zone in zones %}
            <a href="{{ path('game_zone_show', {'zoneId': zone.id}) }}" class="category-card {% if not zone.unlocked %}category-locked{% endif %}">
                <div class="category-icon">{{ zone.icon|default('🌟') }}</div>
                <div class="category-name">{{ zone.name }}</div>
                <div class="category-count">
                    {% if zone.isCompleted %}
                        ✅ Complétée
                    {% elseif zone.isCurrent %}
                        🔹 En cours
                    {% else %}
                        🔒 Débloquée
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </section>
    {% endif %}

    <!-- STATISTIQUES -->
    {% if stats is defined and player is defined and player %}
    <section class="stats-section">
        <h2>📊 Tes Statistiques</h2>
        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-value">{{ stats.totalAnswers }}</div>
                <div class="stat-label">Questions Complétées</div>
            </div>

            <div class="stat-card">
                <div class="stat-value">{{ stats.points }}</div>
                <div class="stat-label">Points d'Expérience</div>
            </div>

            <div class="stat-card">
                <div class="stat-value">{{ stats.percentage }}%</div>
                <div class="stat-label">Taux de Réussite</div>
            </div>

            <div class="stat-card">
                <div class="stat-value">{{ stats.hearts }}</div>
                <div class="stat-label">Cœurs Restants</div>
            </div>

        </div>
    </section>
    {% endif %}
</div>
{% endblock %}